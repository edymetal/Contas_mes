rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInWithVerifiedEmail() {
      return request.auth != null &&
        request.auth.token.email is string &&
        request.auth.token.email_verified == true;
    }

    function authEmail() {
      return request.auth.token.email.lower();
    }

    function adminEmail() {
      return signedInWithVerifiedEmail() && authEmail() in [
        "edneypugleise@gmail.com",
        "edneypugliese.dev@gmail.com"
      ];
    }

    function allowedEmail() {
      return signedInWithVerifiedEmail() && authEmail() in [
        "edneypugleise@gmail.com",
        "edneypugliese.dev@gmail.com",
        "soniapugleise@gmail.com",
        "rodneypugleisemachado@gmail.com"
      ];
    }

    function ownsProfile(profileId) {
      return signedInWithVerifiedEmail() && (
        (profileId == "edney" && adminEmail()) ||
        (profileId == "sonia" && authEmail() == "soniapugleise@gmail.com") ||
        (profileId == "rodney" && authEmail() == "rodneypugleisemachado@gmail.com")
      );
    }

    function validOwnProfileData(profileId) {
      return request.resource.data.keys().hasAll([
          "personId", "name", "email", "photoURL", "updatedAt"
        ]) &&
        request.resource.data.personId == profileId &&
        request.resource.data.email == authEmail() &&
        request.resource.data.name is string &&
        request.resource.data.name.trim().size() > 0 &&
        request.resource.data.name.size() <= 100 &&
        request.resource.data.photoURL is string &&
        request.resource.data.photoURL.size() <= 2048 &&
        request.resource.data.updatedAt is timestamp &&
        request.resource.data.updatedAt == request.time;
    }

    function validOwnProfileCreate(profileId) {
      return validOwnProfileData(profileId) &&
        request.resource.data.keys().hasOnly([
          "personId", "name", "email", "photoURL", "updatedAt"
        ]);
    }

    function validOwnProfileUpdate(profileId) {
      return validOwnProfileData(profileId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "personId", "name", "email", "photoURL", "updatedAt"
        ]);
    }

    match /expenses/{expenseId} {
      allow read: if allowedEmail();
      allow create, update, delete: if adminEmail();
    }

    match /settlements/{settlementId} {
      allow read: if allowedEmail();
      allow create, update, delete: if adminEmail();
    }

    match /marketItems/{itemId} {
      allow read: if allowedEmail();
      allow create, update, delete: if adminEmail();
    }

    match /marketReceipts/{receiptId} {
      allow read: if allowedEmail();
      allow create, update, delete: if adminEmail();
    }

    match /otherPayments/{paymentId} {
      allow read: if allowedEmail();
      allow create, update, delete: if adminEmail();
    }

    match /userProfiles/{profileId} {
      allow read: if allowedEmail();
      allow create: if adminEmail() || (ownsProfile(profileId) && validOwnProfileCreate(profileId));
      allow update: if adminEmail() || (ownsProfile(profileId) && validOwnProfileUpdate(profileId));
      allow delete: if adminEmail();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
